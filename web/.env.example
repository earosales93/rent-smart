# Copia este archivo como .env.local y ajusta los valores.
#
# Son las mismas credenciales que usa la aplicación móvil: ambas apuntan al
# mismo proyecto de Firebase, y por eso comparten usuarios y datos. Los
# valores se obtienen en la consola de Firebase, en
# Configuración del proyecto → Tus aplicaciones → Aplicación web.
#
# El prefijo NEXT_PUBLIC_ hace que Next.js incluya la variable en el paquete
# que se envía al navegador. Eso es correcto y necesario: estas claves
# identifican al proyecto, no autorizan nada. Quien protege los datos son las
# reglas de seguridad de Firestore (archivo firestore.rules), que se evalúan
# en los servidores de Google con el uid de quien hace la petición.
#
# No se versiona ningún archivo .env real: solo este ejemplo.
#
# Las seis variables van vacías a propósito: el proyecto de Firebase lo crea
# el equipo, y hasta entonces estos valores no existen. Al crearlo, Google
# genera el dominio y el depósito de archivos a partir del identificador que
# se elija; si el proyecto se llama rent-smart-udb, quedarán como
# rent-smart-udb.firebaseapp.com y rent-smart-udb.firebasestorage.app. No
# hay que escribirlos a mano: se copian tal cual de la consola, en
# Configuración del proyecto → Tus aplicaciones → Aplicación web.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
